logging.basicConfig(level=logging.DEBUG, format='%(asctime)s - %(levelname)s - %(message)s')
memory = Memory(location='ppm/cache', verbose=0)

class MLSelectedPPM:
    def __init__(self, data_path='ppm/data/historical_data.csv', model_params=None, window_size=5):
        self.models = {
            'lgbm': LGBMClassifier(**(model_params or {'learning_rate': 0.03, 'max_depth': 3, 'n_estimators': 50})),
            'xgb': XGBClassifier(**(model_params or {'learning_rate': 0.03, 'max_depth': 3, 'n_estimators': 50})),
            'nn': self._build_nn_model(),
            'lstm': self._build_attention_model(),
            'transformer': self._build_transformer_model()
        }
        self.model_weights = {'transformer': 0.30, 'lstm': 0.35, 'nn': 0.20, 'lgbm': 0.10, 'xgb': 0.05}
        self.window_size = window_size
        self.feature_names = ['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa', 'weather_adj', 'public_consensus', 'usage_rate']
        try:
            self.data = pd.read_csv(data_path)
            if self.data.empty:
                raise ValueError("Historical data is empty")
            self.data['timestamp'] = pd.to_datetime(self.data['timestamp'], errors='coerce')
            self.data = self._preprocess_data()
            self.train_models()
        except Exception as e:
            logging.error(f"Initialization failed: {e}")
            self.data = pd.DataFrame()

    def _preprocess_data(self):
        try:
            df = self.data.copy()
            df['result'] = df['status'].map({'SETTLED_WIN': 1, 'SETTLED_LOSS': 0, 'SETTLED_PUSH': 0.5})
            df['sport'] = df['sports'].map({'Basketball': 'NBA', 'Ice Hockey': 'NHL', 'American Football': 'CFB', 'Baseball': 'MLB'})
            df = df.sort_values('timestamp').dropna(subset=['timestamp'])
            if df.empty:
                raise ValueError("Preprocessed data is empty")
            return df
        except Exception as e:
            logging.error(f"Preprocessing failed: {e}")
            return pd.DataFrame()

    @memory.cache
    def _engineer_features_vectorized(self, bet_pct, money_pct, spread_move, pace, hfa, weather_adj, public_consensus, usage_rate, sport):
        try:
            disc = np.abs(bet_pct - money_pct)
            weighted_score = disc * 0.01 + pace * 0.25 + hfa * 0.05 + weather_adj * 0.02
            return {'weighted_score': weighted_score, 'features': np.array([bet_pct, money_pct, spread_move, pace, hfa, weather_adj, public_consensus, usage_rate])}
        except Exception as e:
            logging.error(f"Feature engineering failed: {e}")
            return {'weighted_score': 0.0, 'features': np.zeros(8)}

    def _build_nn_model(self):
        try:
            model = Sequential([Dense(32, activation='relu', input_shape=(len(self.feature_names),)), Dropout(0.2), Dense(1, activation='sigmoid')])
            model.compile(optimizer=Adam(learning_rate=0.001), loss='binary_crossentropy')
            return model
        except Exception as e:
            logging.error(f"NN model build failed: {e}")
            return None

    def _build_attention_model(self):
        try:
            model = Sequential([
                Input(shape=(self.window_size, len(self.feature_names))),
                MultiHeadAttention(key_dim=32, num_heads=4),
                Dropout(0.1),
                LayerNormalization(epsilon=1e-6),
                Dense(16, activation='relu'),
                Dropout(0.1),
                Dense(1, activation='sigmoid')
            ])
            model.compile(optimizer=Adam(learning_rate=0.005), loss='binary_crossentropy', callbacks=[EarlyStopping(monitor='loss', patience=5)])
            return model
        except Exception as e:
            logging.error(f"Attention model build failed: {e}")
            return None

    def _build_transformer_model(self):
        try:
            model = Sequential([MultiHeadAttention(key_dim=32, num_heads=2, input_shape=(self.window_size, len(self.feature_names))), Dense(32, activation='relu'), Dense(1, activation='sigmoid')])
            model.compile(optimizer=Adam(learning_rate=0.001), loss='binary_crossentropy')
            return model
        except Exception as e:
            logging.error(f"Transformer model build failed: {e}")
            return None

    def _prepare_time_series_data(self, features):
        try:
            X, y = [], []
            for i in range(len(features) - self.window_size):
                window = np.array([f['features'] for f in features[i:i + self.window_size]])
                if window.shape[1] != len(self.feature_names):
                    continue
                X.append(window)
                y.append(features[i + self.window_size]['weighted_score'] > 0.5)
            return np.array(X), np.array(y)
        except Exception as e:
            logging.error(f"Time series data prep failed: {e}")
            return np.array([]), np.array([])

    def train_models(self):
        try:
            X = self.data[self.feature_names].values
            y = self.data['result'].values
            if X.size == 0 or y.size == 0:
                raise ValueError("Training data is empty")
            self.models['lgbm'].fit(X, y)
            self.models['xgb'].fit(X, y)
            self.models['nn'].fit(X, y, epochs=50, batch_size=32, verbose=0)
            features_list = [self._engineer_features_vectorized(**row) for _, row in self.data.iterrows()]
            X_lstm, y_lstm = self._prepare_time_series_data(features_list)
            if len(X_lstm) > 0:
                dataset = tf.data.Dataset.from_tensor_slices((X_lstm, y_lstm)).batch(32)
                self.models['lstm'].fit(dataset, epochs=50, verbose=0)
            X_trans = X_lstm
            if len(X_trans) > 0:
                self.models['transformer'].fit(X_trans, y_lstm, epochs=50, batch_size=32, verbose=0)
            logging.info("Models trained successfully")
        except Exception as e:
            logging.error(f"Training failed: {e}")

    def simulate_batch(self, bets):
        try:
            if not bets:
                return []
            features = np.array([[b['bet_pct'], b['money_pct'], b['spread_move'], b['pace'], b['hfa'], b.get('weather_adj', 0.0), b.get('public_consensus', 0.5), b.get('usage_rate', 0.25)] for b in bets])
            if features.shape[1] != len(self.feature_names):
                raise ValueError(f"Feature mismatch: expected {len(self.feature_names)}, got {features.shape[1]}")
            lgbm_probs = self.models['lgbm'].predict_proba(features)[:, 1] * 100
            mask = lgbm_probs < 1.0
            historical_features = [self._engineer_features_vectorized(**row) for _, row in self.data.sort_values('timestamp').iloc[-self.window_size:].iterrows()]
            X_lstm = np.array([f['features'] for f in historical_features]).reshape(1, self.window_size, len(self.feature_names))
            results = []
            for i, (bet, prob) in enumerate(zip(bets, lgbm_probs)):
                if mask[i]:
                    results.append({'win_prob': 50.0, 'ev': 0.0})
                else:
                    result = self.simulate_game(game=bet['game'], bet_pct=bet['bet_pct'], money_pct=bet['money_pct'], spread_move=bet['spread_move'], pace=bet['pace'], hfa=bet['hfa'], sport=bet['sport'], odds=bet.get('odds', 1.91), historical_features=historical_features, X_lstm=X_lstm)
                    results.append(result)
            return results
        except Exception as e:
            logging.error(f"Batch simulation failed: {e}")
            return [{'win_prob': 50.0, 'ev': 0.0} for _ in bets]

    def simulate_game(self, game, bet_pct, money_pct, spread_move, pace, hfa, sport, odds=1.91, historical_features=None, X_lstm=None):
        try:
            features = self._engineer_features_vectorized(bet_pct, money_pct, spread_move, pace, hfa, 0.0, 0.5, 0.25, sport)
            if historical_features and X_lstm is not None:
                if X_lstm.shape[1] != self.window_size or X_lstm.shape[2] != len(self.feature_names):
                    raise ValueError(f"X_lstm shape mismatch: expected ({1}, {self.window_size}, {len(self.feature_names)}), got {X_lstm.shape}")
                attention_pred = self.models['lstm'].predict(X_lstm, batch_size=1, verbose=0)[0][0] * 100
            else:
                attention_pred = 50.0
            nn_pred = self.models['nn'].predict(np.array([list(features['features'])], batch_size=1))[0][0] * 100
            lgbm_pred = self.models['lgbm'].predict_proba(np.array([list(features['features'])], batch_size=1))[0][1] * 100
            xgb_pred = self.models['xgb'].predict_proba(np.array([list(features['features'])], batch_size=1))[0][1] * 100
            ensemble_prob = (self.model_weights['lstm'] * attention_pred + self.model_weights['nn'] * nn_pred + self.model_weights['lgbm'] * lgbm_pred + self.model_weights['xgb'] * xgb_pred) / 100
            if not 0 <= ensemble_prob <= 1:
                raise ValueError(f"Invalid ensemble_prob: {ensemble_prob}")
            ev = (ensemble_prob * odds) - (1 - ensemble_prob)
            return {'win_prob': ensemble_prob * 100, 'ev': ev * 100}
        except Exception as e:
            logging.error(f"Game simulation failed for {game}: {e}")
            return {'win_prob': 50.0, 'ev': 0.0}

    def calculate_ev(self, win_prob, odds):
        try:
            implied_prob = 1 / odds
            vig = 0.045
            true_odds = odds / (1 + vig)
            ev = (win_prob / 100 * true_odds) - (1 - win_prob / 100)
            return ev * 100
        except Exception as e:
            logging.error(f"EV calculation failed: {e}")
            return 0.0
