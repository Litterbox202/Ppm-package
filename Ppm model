import pandas as pd
from datetime import datetime
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Dense
from tensorflow.keras.optimizers import Adam
import numpy as np
import os

class PerformanceTracker:
    def __init__(self, data_path='ppm/data/bet_log.csv'):
        self.data_path = data_path
        self.bet_log = pd.read_csv(data_path) if os.path.exists(data_path) else pd.DataFrame(columns=['game', 'bet', 'odds', 'win_prob', 'ev', 'stake', 'result', 'clv', 'timestamp'])
        self.autoencoder = self._build_autoencoder()
        if not self.bet_log.empty:
            self._train_autoencoder()

    def _build_autoencoder(self):
        input_dim = 9  # game, bet, odds, win_prob, ev, stake, result, clv, timestamp
        input_layer = Input(shape=(input_dim,))
        encoded = Dense(16, activation='relu')(input_layer)
        encoded = Dense(8, activation='relu')(encoded)
        decoded = Dense(16, activation='relu')(encoded)
        decoded = Dense(input_dim, activation='sigmoid')(decoded)
        autoencoder = Model(input_layer, decoded)
        autoencoder.compile(optimizer=Adam(learning_rate=0.001), loss='mse')
        return autoencoder

    def _train_autoencoder(self):
        features = self.bet_log[['odds', 'win_prob', 'ev', 'stake', 'result', 'clv']].dropna().values
        if len(features) > 0:
            self.autoencoder.fit(features, features, epochs=50, batch_size=32, shuffle=True, validation_split=0.2, verbose=0)

    def log_bet(self, game, bet, odds, win_prob, ev, stake, result=None, closing_odds=None):
        clv = self._calculate_clv(odds, closing_odds) if closing_odds else 0.0
        new_bet = pd.DataFrame([{
            'game': game, 'bet': bet, 'odds': odds, 'win_prob': win_prob, 'ev': ev,
            'stake': stake, 'result': result, 'clv': clv, 'timestamp': datetime.now()
        }])
        new_features = new_bet[['odds', 'win_prob', 'ev', 'stake', 'result', 'clv']].values
        if self._detect_anomaly(new_features):
            historical = self.bet_log[['odds', 'win_prob', 'ev', 'stake', 'result', 'clv']].median()
            for col in ['odds', 'win_prob', 'ev', 'stake']:
                if abs(new_bet[col].iloc[0] - historical[col]) > 2 * np.std(self.bet_log[col].dropna()):
                    new_bet[col] = historical[col]
        self.bet_log = pd.concat([self.bet_log, new_bet], ignore_index=True)
        self.bet_log.to_csv(self.data_path, index=False)

    def _detect_anomaly(self, features):
        if self.autoencoder:
            reconstructed = self.autoencoder.predict(features)
            mse = np.mean(np.power(features - reconstructed, 2), axis=1)
            historical_mse = np.mean(np.power(self.bet_log[['odds', 'win_prob', 'ev', 'stake', 'result', 'clv']].dropna().values - self.autoencoder.predict(self.bet_log[['odds', 'win_prob', 'ev', 'stake', 'result', 'clv']].dropna().values), 2))
            return mse > historical_mse + 2 * np.std(historical_mse)
        return False

    def _calculate_clv(self, bet_odds, close_odds):
        bet_prob = self._odds_to_prob(bet_odds)
        close_prob = self._odds_to_prob(close_odds)
        return (bet_prob - close_prob) * 100 if close_odds else 0.0

    def _odds_to_prob(self, odds):
        if odds > 0:
            return 100 / (odds + 100)
        else:
            return -odds / (-odds + 100)

    def analyze_performance(self):
        hits = self.bet_log[self.bet_log['result'] == 1].shape[0]
        total = self.bet_log.shape[0]
        roi = (self.bet_log['result'].sum() * 100 - self.bet_log['stake'].sum()) / self.bet_log['stake'].sum() * 100
        avg_clv = self.bet_log['clv'].mean()
        return {'hit_rate': f"{(hits / total * 100):.1f}%", 'roi': f"{roi:.1f}%", 'avg_clv': f"{avg_clv:.1f}%"}
