import requests
from bs4 import BeautifulSoup
import pandas as pd
import sqlite3
import time
import random
from datetime import datetime

class FallbackScraper:
    def __init__(self, cache_db='ppm/data/scrape_cache.db'):
        self.cache_db = cache_db
        self.session = requests.Session()
        self.session.headers.update({'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'})
        self.conn = sqlite3.connect(self.cache_db)
        self.conn.execute('''CREATE TABLE IF NOT EXISTS cache (key TEXT PRIMARY KEY, data TEXT, timestamp DATETIME)''')

    def _rate_limit(self):
        time.sleep(random.uniform(1, 2))  # 1-2s delay

    def _get_from_cache(self, key):
        cursor = self.conn.execute('SELECT data FROM cache WHERE key=? AND timestamp > datetime("now", "-1 hour")', (key,))
        row = cursor.fetchone()
        return row[0] if row else None

    def _put_to_cache(self, key, data):
        self.conn.execute('INSERT OR REPLACE INTO cache (key, data, timestamp) VALUES (?, ?, ?)', (key, data, datetime.now()))
        self.conn.commit()

    def fetch_scores(self, sport, date=None):
        key = f"{sport}_scores_{date or 'today'}"
        cached = self._get_from_cache(key)
        if cached:
            return pd.read_json(cached)
        self._rate_limit()
        if sport == 'nba':
            url = 'https://www.espn.com/nba/schedule/_/date/' + (date or datetime.now().strftime('%Y%m%d'))
        elif sport == 'nhl':
            url = 'https://www.nhl.com/scores'
        # Add for other sports
        response = self.session.get(url)
        if response.status_code != 200:
            raise Exception(f"Scrape failed: {response.status_code}")
        soup = BeautifulSoup(response.text, 'html.parser')
        games = []
        for row in soup.find_all('tr', class_='ScheduleTable__tr'):
            teams = row.find_all('span', class_='Table__TRLabel')
            scores = row.find_all('span', class_='Table__TRLabel')
            if teams and scores:
                games.append({'away': teams[0].text, 'home': teams[1].text, 'away_score': scores[0].text, 'home_score': scores[1].text})
        df = pd.DataFrame(games)
        self._put_to_cache(key, df.to_json())
        return df

    def fetch_injuries(self, sport, team=None):
        key = f"{sport}_injuries_{team or 'all'}"
        cached = self._get_from_cache(key)
        if cached:
            return pd.read_json(cached)
        self._rate_limit()
        url = f'https://www.espn.com/{sport}/injuries'
        response = self.session.get(url)
        soup = BeautifulSoup(response.text, 'html.parser')
        injuries = []
        for tr in soup.find_all('tr', class_='Table__TR'):
            player = tr.find('td', class_='Table__TD')
            status = tr.find('td', class_='Table__TD status')
            if player and status:
                injuries.append({'player': player.text, 'status': status.text})
        df = pd.DataFrame(injuries)
        self._put_to_cache(key, df.to_json())
        return df

    def fetch_odds(self, sport, game):
        key = f"{sport}_odds_{game}"
        cached = self._get_from_cache(key)
        if cached:
            return pd.read_json(cached)
        self._rate_limit()
        url = f'https://sportsbook.draftkings.com/odds/{sport}/{game}'
        response = self.session.get(url)
        soup = BeautifulSoup(response.text, 'html.parser')
        odds = []
        for line in soup.find_all('div', class_='sportsbook-odds'):
            spread = line.find('span', class_='spread')
            total = line.find('span', class_='total')
            if spread and total:
                odds.append({'spread': spread.text, 'total': total.text})
        df = pd.DataFrame(odds)
        self._put_to_cache(key, df.to_json())
        return df
