# ppm/utils/data_preprocessing.py
import requests
import pandas as pd
import hashlib
import asyncio
from bs4 import BeautifulSoup
from .fallback_scraper import FallbackScraper
from sportsipy.nfl.boxscore import Boxscores
from sportsipy.nba.boxscore import Schedule
import numpy as np
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Input, Dense
from tensorflow.keras.optimizers import Adam
from datetime import datetime
import os

class DataPreprocessor:
    def __init__(self, data_path='ppm/data/historical_data.csv'):
        self.data_path = data_path
        self.data = pd.read_csv(data_path) if os.path.exists(data_path) else pd.DataFrame()
        self.scraper = FallbackScraper()
        self.last_update = datetime.min
        self.schema = {
            'scores': {'away_score': int, 'home_score': int},
            'injuries': {'player': str, 'status': str},
            'odds': {'spread': float, 'total': float}
        }
        self.autoencoder = self._build_autoencoder()
        if not self.data.empty:
            self._train_autoencoder()

    def _build_autoencoder(self):
        input_dim = 8  # bet_pct, money_pct, spread_move, pace, hfa, weather_adj, public_consensus, usage_rate
        input_layer = Input(shape=(input_dim,))
        encoded = Dense(16, activation='relu')(input_layer)
        encoded = Dense(8, activation='relu')(encoded)
        decoded = Dense(16, activation='relu')(encoded)
        decoded = Dense(input_dim, activation='sigmoid')(decoded)
        autoencoder = Model(input_layer, decoded)
        autoencoder.compile(optimizer=Adam(learning_rate=0.001), loss='mse')
        return autoencoder

    def _train_autoencoder(self):
        features = self.data[['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa', 'weather_adj', 'public_consensus', 'usage_rate']].dropna().values
        if len(features) > 0:
            self.autoencoder.fit(features, features, epochs=50, batch_size=32, shuffle=True, validation_split=0.2, verbose=0)

    async def fetch_live_data(self, sport, game, city=None):
        sources = {
            'nba': ['https://www.balldontlie.io/api/v1/games', 'https://www.espn.com/nba/schedule'],
            'nhl': ['https://api.sportsdata.io/v3/nhl/scores/json/GamesByDate', 'https://www.nhl.com/scores'],
            'nfl': ['https://www.balldontlie.io/api/v1/games', 'https://www.espn.com/nfl/schedule'],
            'mlb': ['https://api.sportsdata.io/v3/mlb/scores/json/GamesByDate', 'https://www.mlb.com/scores'],
            'ncaaf': ['https://api.sportsdata.io/v3/cfb/scores/json/GamesByDate', 'https://www.espn.com/college-football/schedule']
        }
        data_points = {'sources': []}
        for url in sources.get(sport.lower(), []):
            try:
                response = requests.get(url, timeout=5)
                if response.status_code == 200:
                    soup = BeautifulSoup(response.text, 'html.parser') if 'espn' in url or 'nhl' in url else response.json()
                    if 'espn' in url:
                        scores = [td.text for td in soup.find_all('td', class_='Table__TD')]
                        data = {'scores': scores[:2] if len(scores) >= 2 else [0, 0], 'bet_pct': 60, 'money_pct': 50, 'spread_move': 0, 'pace': 100, 'hfa': 0.03}
                    elif 'nhl' in url:
                        data = {'scores': [span.text for span in soup.find_all('span', class_='score')], 'bet_pct': 60, 'money_pct': 50, 'spread_move': 0, 'pace': 100, 'hfa': 0.03}
                    else:
                        data = soup.get('data', {})
                        data.update({'bet_pct': 60, 'money_pct': 50, 'spread_move': 0, 'pace': 100, 'hfa': 0.03})
                    data['source'] = url
                    data_points['sources'].append(data)
            except Exception as e:
                continue
        if not data_points['sources']:
            fallback = await self._fetch_fallback(sport, game)
            data_points['sources'].append(fallback)
        return self._validate_and_consolidate(data_points, sport, city)

    async def _fetch_fallback(self, sport, game):
        return self.scraper.fetch_scores(sport) if 'scores' in game else self.scraper.fetch_injuries(sport)

    def _validate_and_consolidate(self, data_points, sport, city):
        if not data_points['sources']:
            return {}
        consolidated = {}
        for key in self.schema:
            values = [d.get(key, {}) for d in data_points['sources'] if key in d]
            if values:
                validated = self._cross_validate(values, key)
                if validated:
                    consolidated.update(validated)
        consolidated['weather_adj'] = self._fetch_weather(city) if city else 0.0
        consolidated['timestamp'] = datetime.now()
        consolidated = self._detect_and_correct_anomalies(consolidated)
        checksum = hashlib.md5(str(consolidated).encode()).hexdigest()
        if checksum in self.data.get('checksum', []):
            return self.data[self.data['checksum'] == checksum].iloc[0]
        self._validate_schema(consolidated)
        self._check_temporal_consistency(consolidated)
        self.data = pd.concat([self.data, pd.DataFrame([consolidated])], ignore_index=True)
        self.data.to_csv(self.data_path, index=False)
        return consolidated

    def _cross_validate(self, values, key):
        if not values:
            return {}
        if key == 'scores':
            away_scores = [int(v[0]) if v[0].isdigit() else 0 for v in values if len(v) > 0]
            home_scores = [int(v[1]) if v[1].isdigit() else 0 for v in values if len(v) > 1]
            if len(away_scores) > 1 and len(home_scores) > 1:
                return {'away_score': int(np.median(away_scores)), 'home_score': int(np.median(home_scores))}
        return {}

    def _detect_and_correct_anomalies(self, data):
        if 'bet_pct' in data and self.autoencoder:
            features = pd.DataFrame([data])[['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa', 'weather_adj', 'public_consensus', 'usage_rate']].fillna(0).values
            reconstructed = self.autoencoder.predict(features)
            mse = np.mean(np.power(features - reconstructed, 2), axis=1)
            historical_mse = np.mean(np.power(self.data[['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa', 'weather_adj', 'public_consensus', 'usage_rate']].dropna().values - self.autoencoder.predict(self.data[['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa', 'weather_adj', 'public_consensus', 'usage_rate']].dropna().values), 2))
            if mse > historical_mse + 2 * np.std(historical_mse):
                historical = self.data[['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa', 'weather_adj', 'public_consensus', 'usage_rate']].median()
                for col in ['bet_pct', 'money_pct', 'spread_move', 'pace', 'hfa']:
                    if col in data:
                        data[col] = historical[col]
        return data

    def _validate_schema(self, data):
        for key, expected_type in self.schema.get('scores', {}).items():
            if key in data and not isinstance(data[key], expected_type):
                raise ValueError(f"Invalid type for {key}: expected {expected_type}")

    def _check_temporal_consistency(self, data):
        if 'timestamp' in data and data['timestamp'] > datetime.now():
            data['timestamp'] = datetime.now()
        if 'scores' in data and (data.get('away_score', 0) > 200 or data.get('home_score', 0) > 200):
            data['away_score'] = 0
            data['home_score'] = 0

    def _fetch_weather(self, city):
        try:
            response = requests.get(f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid=YOUR_API_KEY", timeout=5)
            return -0.02 if response.json().get('weather', [{}])[0].get('main') == 'Rain' else 0.0
        except:
            return 0.0

    def fetch_advanced_stats(self, sport, player):
        if sport == 'nfl':
            boxscores = Boxscores(datetime.now().year, datetime.now().month)
            return pd.DataFrame([stats for game in boxscores.games for stats in game.players if player in stats.player])
        elif sport == 'nba':
            schedule = Schedule(datetime.now().year, datetime.now().month)
            return pd.DataFrame([stats for game in schedule.games for stats in game.players if player in stats.player])
        return pd.DataFrame()
