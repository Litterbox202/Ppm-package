import numpy as np
import pandas as pd
from dataclasses import dataclass
from typing import Dict, List, Optional, Any
from datetime import datetime
import json
import os

# ===================================================================
# 1. DATA & LOGGING
# ===================================================================

@dataclass
class Bet:
    bet_id: str
    sportsbook: str
    type: str
    status: str
    odds: Optional[float]
    closing_line: Optional[float]
    ev: Optional[float]
    amount: float
    profit: float
    time_placed: datetime
    time_settled: Optional[datetime]
    time_placed_iso: str
    time_settled_iso: Optional[str]
    bet_info: str
    tags: str
    sports: str
    leagues: str

    @property
    def return_pct(self) -> float:
        return self.profit / self.amount if self.amount > 0 else 0.0

    @property
    def win(self) -> bool:
        return self.status == "SETTLED_WIN"


def load_bets_from_csv(path: str) -> List[Bet]:
    bets = []
    if not os.path.exists(path):
        print(f"Warning: {path} not found.")
        return bets
    df = pd.read_csv(path)
    for _, row in df.iterrows():
        try:
            bets.append(Bet(
                bet_id=str(row["bet_id"]),
                sportsbook=row["sportsbook"],
                type=row["type"],
                status=row["status"],
                odds=float(row["odds"]) if pd.notna(row["odds"]) else None,
                closing_line=float(row["closing_line"]) if pd.notna(row["closing_line"]) else None,
                ev=float(row["ev"]) if pd.notna(row["ev"]) else None,
                amount=float(row["amount"]),
                profit=float(row["profit"]),
                time_placed=datetime.strptime(row["time_placed"], "%m/%d/%Y %H:%M:%S %Z"),
                time_settled=datetime.strptime(row["time_settled"], "%m/%d/%Y %H:%M:%S %Z") if pd.notna(row["time_settled"]) else None,
                time_placed_iso=row["time_placed_iso"],
                time_settled_iso=row["time_settled_iso"] if pd.notna(row["time_settled_iso"]) else None,
                bet_info=row["bet_info"],
                tags=row["tags"],
                sports=row["sports"],
                leagues=row["leagues"]
            ))
        except Exception as e:
            print(f"Error parsing bet {row.get('bet_id', 'unknown')}: {e}")
    return bets


# ===================================================================
# 2. RISK METRICS
# ===================================================================

class SharpeOptimizer:
    RISK_FREE_RATE = 0.04
    WINDOW = 50

    def __init__(self):
        self.returns = []

    def add_return(self, ret: float):
        self.returns.append(ret)
        if len(self.returns) > self.WINDOW:
            self.returns.pop(0)

    def sharpe_ratio(self) -> float:
        if len(self.returns) < 2: return 0.0
        excess = np.array(self.returns) - self.RISK_FREE_RATE / 252
        return np.mean(excess) / (np.std(excess) + 1e-8) * np.sqrt(252)


class SortinoOptimizer:
    RISK_FREE_RATE = 0.04
    WINDOW = 50
    TARGET_RETURN = 0.0

    def __init__(self):
        self.returns = []

    def add_return(self, ret: float):
        self.returns.append(ret)
        if len(self.returns) > self.WINDOW:
            self.returns.pop(0)

    def downside_deviation(self) -> float:
        negative = [r - self.TARGET_RETURN for r in self.returns if r < self.TARGET_RETURN]
        return np.sqrt(np.mean([x**2 for x in negative])) if negative else 1e-8

    def sortino_ratio(self) -> float:
        if len(self.returns) < 2: return 0.0
        excess = np.mean(self.returns) - self.RISK_FREE_RATE / 252
        return excess / self.downside_deviation() * np.sqrt(252)


class CalmarOptimizer:
    RISK_FREE_RATE = 0.04
    WINDOW = 100

    def __init__(self):
        self.bankrolls = []
        self.peak = 1000.0

    def add_bankroll(self, bankroll: float):
        self.bankrolls.append(bankroll)
        if len(self.bankrolls) > self.WINDOW:
            self.bankrolls.pop(0)
        self.peak = max(self.peak, bankroll)

    def max_drawdown(self) -> float:
        if not self.bankrolls: return 0.0
        peak = max(self.bankrolls)
        trough = min(self.bankrolls)
        return (peak - trough) / peak if peak > 0 else 0.0

    def annualized_return(self) -> float:
        if len(self.bankrolls) < 2: return 0.0
        start, end = self.bankrolls[0], self.bankrolls[-1]
        days = len(self.bankrolls)
        return (end / start) ** (252 / days) - 1 if start > 0 else 0.0

    def calmar_ratio(self) -> float:
        ret = self.annualized_return()
        dd = self.max_drawdown()
        return (ret - self.RISK_FREE_RATE) / dd if dd > 0 else 0.0


class SterlingOptimizer:
    RISK_FREE_RATE = 0.04
    WINDOW = 100

    def __init__(self):
        self.bankrolls = []
        self.peak = 1000.0

    def add_bankroll(self, bankroll: float):
        self.bankrolls.append(bankroll)
        if len(self.bankrolls) > self.WINDOW:
            self.bankrolls.pop(0)
        self.peak = max(self.peak, bankroll)

    def average_drawdown(self) -> float:
        if not self.bankrolls: return 0.0
        drawdowns = []
        current_peak = self.bankrolls[0]
        for b in self.bankrolls:
            if b > current_peak: current_peak = b
            dd = (current_peak - b) / current_peak if current_peak > 0 else 0.0
            drawdowns.append(dd)
        return np.mean(drawdowns) if drawdowns else 0.0

    def annualized_return(self) -> float:
        if len(self.bankrolls) < 2: return 0.0
        start, end = self.bankrolls[0], self.bankrolls[-1]
        days = len(self.bankrolls)
        return (end / start) ** (252 / days) - 1 if start > 0 else 0.0

    def sterling_ratio(self) -> float:
        ret = self.annualized_return()
        avg_dd = self.average_drawdown()
        return (ret - self.RISK_FREE_RATE) / avg_dd if avg_dd > 0 else 0.0


class BurkeOptimizer:
    RISK_FREE_RATE = 0.04
    WINDOW = 100

    def __init__(self):
        self.bankrolls = []
        self.peak = 1000.0

    def add_bankroll(self, bankroll: float):
        self.bankrolls.append(bankroll)
        if len(self.bankrolls) > self.WINDOW:
            self.bankrolls.pop(0)
        self.peak = max(self.peak, bankroll)

    def squared_drawdowns(self) -> float:
        if not self.bankrolls: return 0.0
        drawdowns = []
        current_peak = self.bankrolls[0]
        for b in self.bankrolls:
            if b > current_peak: current_peak = b
            dd = (current_peak - b) / current_peak if current_peak > 0 else 0.0
            drawdowns.append(dd ** 2)
        return np.sum(drawdowns)

    def annualized_return(self) -> float:
        if len(self.bankrolls) < 2: return 0.0
        start, end = self.bankrolls[0], self.bankrolls[-1]
        days = len(self.bankrolls)
        return (end / start) ** (252 / days) - 1 if start > 0 else 0.0

    def burke_ratio(self) -> float:
        ret = self.annualized_return()
        sq_dd = self.squared_drawdowns()
        return (ret - self.RISK_FREE_RATE) / np.sqrt(sq_dd + 1e-8) if sq_dd > 0 else 0.0


# ===================================================================
# 3. HMG-HER GOALS
# ===================================================================

class HMGHERGoals:
    SUBGOALS = ["ev", "roi", "risk", "streak", "variance", "sharpe", "sortino", "calmar", "sterling", "burke"]

    @staticmethod
    def compute(state: Dict, next_state: Dict, history: list, optimizers: Dict) -> Dict[str, float]:
        ev = next_state.get("ev", 0.0)
        roi = (next_state["bankroll"] - state["bankroll"]) / state["bankroll"] if state["bankroll"] > 0 else 0.0
        risk = min([h["bankroll"] for h in history[-10:]]) / max([h["bankroll"] for h in history[-10:]]) if history else 1.0
        streak = state.get("streak", 0) + 1 if next_state.get("win") else 0
        returns = [h["return"] for h in history[-10:]]
        variance = np.std(returns) if len(returns) > 1 else 0.0
        sharpe = optimizers["sharpe"].sharpe_ratio()
        sortino = optimizers["sortino"].sortino_ratio()
        calmar = optimizers["calmar"].calmar_ratio()
        sterling = optimizers["sterling"].sterling_ratio()
        burke = optimizers["burke"].burke_ratio()

        return {
            "ev": ev, "roi": roi, "risk": risk, "streak": streak, "variance": variance,
            "sharpe": sharpe, "sortino": sortino, "calmar": calmar, "sterling": sterling, "burke": burke
        }

    @staticmethod
    def compute_reward(goal: str, value: float) -> float:
        thresholds = {
            "ev": 0.05, "roi": 0.03, "risk": 0.97, "streak": 3, "variance": 0.02,
            "sharpe": 1.5, "sortino": 1.8, "calmar": 2.0, "sterling": 2.2, "burke": 2.5
        }
        return 1.0 if value > thresholds.get(goal, 0) else -0.1


# ===================================================================
# 4. EDGE ENGINE v32
# ===================================================================

class EdgeEngine:
    @staticmethod
    def score(bet: Dict) -> float:
        score = 0.0
        if bet.get("ev", 0) > 0.05 and bet.get("cl_beat", 0) > 0.5:
            score += 0.40
        if bet.get("sharp_pct", 0) > 0.60 and bet.get("is_midweek"):
            score += 0.30
        if bet.get("is_nhl") and bet.get("is_rr") and bet.get("num_legs", 0) in [2, 3]:
            score += 0.35
        if bet.get("is_wnba") and bet.get("is_over") and ("A'ja" in bet.get("info", "") or "Satou" in bet.get("info", "")):
            score += 0.25
        if bet.get("her_relabel"):
            score += 0.39
        return min(score, 1.0)


class LossTrapFilter:
    @staticmethod
    def is_banned(bet: Dict) -> bool:
        if bet.get("is_mlb"): return True
        if bet.get("num_legs", 0) > 6: return True
        if bet.get("public_pct", 0) > 0.75: return True
        if bet.get("is_nfl") and bet.get("ev", 0) < 0.03: return True
        if bet.get("is_weekend") and bet.get("ev", 0) < 0.03: return True
        if bet.get("time_to_settlement", 999) < 60: return True
        return False


class CorrelationStaking:
    @staticmethod
    def stake(bet: Dict, bankroll: float) -> float:
        if LossTrapFilter.is_banned(bet):
            return 0.0

        edge_score = EdgeEngine.score(bet)
        ev = bet.get("ev", 0.0)
        odds = bet.get("odds", 1.91)
        kelly = (ev * (odds - 1)) / (odds - 1) if ev > 0 else 0

        multiplier = 1.0
        if edge_score > 0.8: multiplier = 2.5
        elif edge_score > 0.6: multiplier = 1.8
        elif edge_score > 0.4: multiplier = 1.3

        stake = kelly * multiplier * bankroll
        return min(stake, bankroll * 0.25)


class HERV2:
    @staticmethod
    def relabel(bet: Dict) -> Dict:
        if bet.get("status") == "SETTLED_LOSS":
            if bet.get("cl_beat", 0) > 0.3:
                bet["her_relabel"] = True
                bet["intrinsic_reward"] = 1.0
            elif bet.get("sharp_pct", 0) > 0.65:
                bet["her_relabel"] = True
                bet["intrinsic_reward"] = 0.8
        return bet


# ===================================================================
# 5. SIMULATOR (PPM CORE)
# ===================================================================

class BaseSimulator:
    def __init__(self, initial_bankroll: float = 1000.0):
        self.bankroll = initial_bankroll
        self.history = []
        self.optimizers = {
            "sharpe": SharpeOptimizer(),
            "sortino": SortinoOptimizer(),
            "calmar": CalmarOptimizer(),
            "sterling": SterlingOptimizer(),
            "burke": BurkeOptimizer()
        }

    def _build_bet_dict(self, **kwargs) -> Dict:
        return {
            "ev": kwargs.get("ev", 0.0),
            "cl_beat": kwargs.get("closing_line", 0) - kwargs.get("odds", 1.91) if kwargs.get("closing_line") else 0,
            "sharp_pct": kwargs.get("sharp_pct", 50),
            "is_nhl": kwargs.get("sports") == "Ice Hockey",
            "is_wnba": kwargs.get("leagues") == "WNBA",
            "is_mlb": kwargs.get("leagues") == "MLB",
            "is_nfl": kwargs.get("leagues") == "NFL",
            "is_rr": "round_robin" in kwargs.get("type", "").lower(),
            "num_legs": len(kwargs.get("bet_info", "").split("|")) if "|" in kwargs.get("bet_info", "") else 1,
            "is_over": "Over" in kwargs.get("bet_info", ""),
            "is_midweek": kwargs.get("time_placed").weekday() in [1,2,3],
            "is_weekend": kwargs.get("time_placed").weekday() in [4,5,6],
            "public_pct": kwargs.get("public_pct", 50),
            "time_to_settlement": (kwargs.get("time_settled") - kwargs.get("time_placed")).total_seconds() / 60 if kwargs.get("time_settled") else 999,
            "info": kwargs.get("bet_info", "")
        }

    def simulate_bet(self, **context) -> Dict:
        bet = self._build_bet_dict(**context)
        bet = HERV2.relabel(bet)

        if LossTrapFilter.is_banned(bet):
            return {"action": "SKIP", "stake": 0.0}

        stake = CorrelationStaking.stake(bet, self.bankroll)
        if stake <= 0:
            return {"action": "SKIP", "stake": 0.0}

        # Simulate outcome
        win_prob = 0.5 + bet.get("ev", 0) * 10 + EdgeEngine.score(bet) * 0.3
        win_prob = np.clip(win_prob, 0.1, 0.95)
        win = np.random.rand() < win_prob
        payout = stake * (bet.get("odds", 1.91) - 1) if win else -stake

        self.bankroll += payout
        self.history.append({"return": payout / 1000.0, "bankroll": self.bankroll})

        for opt in self.optimizers.values():
            opt.add_bankroll(self.bankroll)

        return {
            "action": "BET" if stake > 0 else "SKIP",
            "stake": stake,
            "payout": payout,
            "bankroll": self.bankroll,
            "edge_score": EdgeEngine.score(bet),
            "win_prob": win_prob,
            "win": win
        }


# ===================================================================
# 6. TRAINING & DASHBOARD
# ===================================================================

def train_and_dashboard(csv_path: str):
    bets = load_bets_from_csv(csv_path)
    settled = [b for b in bets if b.status in ["SETTLED_WIN", "SETTLED_LOSS"]]
    sim = BaseSimulator(initial_bankroll=1000.0)

    for bet in settled:
        context = bet.__dict__
        result = sim.simulate_bet(**context)
        # Optional: log result

    print(f"""
    PPM v32.0.0 — FULL TRAINING COMPLETE
    ========================================
    Bets Trained: {len(settled)}
    Final Bankroll: ${sim.bankroll:,.2f}
    ROI: {(sim.bankroll - 1000) / 1000 * 100:.2f}%
    Sharpe: {sim.optimizers['sharpe'].sharpe_ratio():.2f}
    Sortino: {sim.optimizers['sortino'].sortino_ratio():.2f}
    Calmar: {sim.optimizers['calmar'].calmar_ratio():.2f}
    Sterling: {sim.optimizers['sterling'].sterling_ratio():.2f}
    Burke: {sim.optimizers['burke'].burke_ratio():.2f}
    """)


# ===================================================================
# 7. RUN
# ===================================================================

if __name__ == "__main__":
    # Replace with your CSV path
    train_and_dashboard("your_bets.csv")

